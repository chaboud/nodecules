# Nodecules Environment Configuration
# Copy this file to .env and fill in your actual values

# Core Database & Services
DATABASE_URL=postgresql://nodecules:nodecules@postgres:5432/nodecules
REDIS_URL=redis://redis:6379/0

# AI Provider API Keys
# Uncomment and set the providers you want to use

# Anthropic Claude API
# Get your key from: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# AWS Bedrock - Option 1: Bearer Token (Recommended - simpler setup)
# Get your API key from AWS Console > Bedrock > API Keys
# AWS_BEARER_TOKEN_BEDROCK=your-bedrock-api-key-here
# AWS_REGION=us-east-1

# AWS Bedrock - Option 2: Full AWS Credentials (if you don't have API key)
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_REGION=us-east-1

# OpenAI API (for future support)
# OPENAI_API_KEY=sk-your-openai-key-here

# Environment Configuration
# NODE_ENV=development
# LOG_LEVEL=info

# Optional: Custom Ollama endpoint (if not using default local)
# OLLAMA_BASE_URL=http://localhost:11434